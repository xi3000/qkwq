-- Steal a Brainrot x8 Luck Buff GUI (iOS Debug Version - Sep 2025)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local MULTIPLIER = 999
local ENABLED = false

print("🔧 Delta iOS Debug: Script loaded! Waiting for GUI...")

-- Create GUI (same as before)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "LuckBuffGUI"
ScreenGui.ResetOnSpawn = false

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 100, 0, 50)
Frame.Position = UDim2.new(0.02, 0, 0.02, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.BorderSizePixel = 0
Frame.Parent = ScreenGui

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(1, 0, 1, 0)
Button.Text = "Luck x8: OFF"
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Button.TextScaled = true
Button.Font = Enum.Font.SourceSansBold
Button.Parent = Frame

print("🔧 Debug: GUI created! If no button visible, check CoreGui in explorer.")

-- Buff function (same)
local function buffLuck()
    if not ENABLED then return end
    print("🔧 Buffing luck...")  -- Debug
    local playerData = ReplicatedStorage:FindFirstChild("PlayerData") and ReplicatedStorage.PlayerData:FindFirstChild(player.Name)
    if playerData then
        local luckValue = playerData:FindFirstChild("LuckMultiplier") or playerData:FindFirstChild("Luck")
        if luckValue then
            luckValue.Value = MULTIPLIER
            print("✅ Luck x" .. MULTIPLIER .. " set!")
        else
            print("❌ No Luck value found - Game updated?")
        end
    end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local luckRemote = remotes:FindFirstChild("UpdateLuck") or remotes:FindFirstChild("ApplyBuff")
        if luckRemote then pcall(function() luckRemote:FireServer(MULTIPLIER) end) end
    end
end

local function toggleLuck()
    ENABLED = not ENABLED
    Button.Text = ENABLED and "Luck x8: ON" or "Luck x8: OFF"
    Button.BackgroundColor3 = ENABLED and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(50, 50, 50)
    print(ENABLED and "🔥 x8 Luck ON" or "❌ x8 Luck OFF")
    if ENABLED then buffLuck() end
end

Button.MouseButton1Click:Connect(toggleLuck)
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.L then toggleLuck() end
end)

RunService.Heartbeat:Connect(function()
    if ENABLED then buffLuck() end
end)

print("🚀 GUI ready! Click button or L key. If no print, Delta not injecting.")
